{
  "extends": "typescript-config/react.json",
  "compilerOptions": {
    // "target": "ES2022",
    // "noEmit": true,
    // "jsx": "preserve",
    // "incremental": true,
    // "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noEmit": true,
    "incremental": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
