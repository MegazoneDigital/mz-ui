{
  "extends": "typescript-config/react.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".storybook/**/*", "src/**/*", "stories/**/*"],
  "exclude": ["node_modules"]
}
