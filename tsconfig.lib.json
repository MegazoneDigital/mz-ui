{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": false,
    "noEmit": false
  },
  "include": [
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/utils/**/*.ts"
  ],
  "exclude": [
    "**/*.stories.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
